{
  "name": "breathe-rhythm",
  "version": "1.0.0",
  "author": "Oksana Kudakaeva <https://github.com/okudakaeva>",
  "description": "Движок визуализации стихов BreatheRhythm",
  "license": "Custom Proprietary License (SEE IN LICENSE.md)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okudakaeva/breathe-rhythm.git"
  },
  "homepage": "https://okudakaeva.github.io/breathe-rhythm/",
  "keywords": [
    "canvas",
    "poetry",
    "generative-art",
    "digital-art",
    "typescript"
  ],
  "scripts": {
    "build": "tsc --noEmit && esbuild ./src/main.ts ./src/breathe_rhythm_engine.ts ./src/ui/index.ts --bundle --splitting --minify --sourcemap --format=esm --target=es2022 --outdir=src",
    "watch": "esbuild ./src/main.ts ./src/breathe_rhythm_engine.ts ./src/ui/index.ts --bundle --splitting --sourcemap --format=esm --target=es2022 --outdir=src --watch"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.4.5"
  }
}
